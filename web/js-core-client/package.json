{
  "name": "@deephaven/js-core-client",
  "version": "0.0.0-dummy",
  "description": "Deephaven Core JS client (TypeScript). Pairs with the thin OpenAPI layer served by a Deephaven server at /jsapi/dh-internal.js.",
  "author": "Deephaven Data Labs LLC",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/deephaven/deephaven-core.git",
    "directory": "web/js-core-client"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --format=esm --outfile=dist-browser/index.js --platform=browser --legal-comments=none",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@improbable-eng/grpc-web": "^0.15.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "apache-arrow": "^21.1.0",
    "flatbuffers": "^25.9.23"
  }
}
